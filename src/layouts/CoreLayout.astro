---
import { ClientRouter, fade, slide } from 'astro:transitions';
import '@/styles/global.css';
import CoreHeader from '@/components/ui/CoreHeader.astro';
import CoreFooter from '@/components/ui/CoreFooter.astro';
import LoadingOverlay from '@/components/ui/LoadingOverlay.astro';

interface Props {
  title: string;
  subtitle: string;
  bgImage: string;
}

const { title, subtitle, bgImage } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {subtitle}</title>
    <meta property="og:image" content={bgImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <ClientRouter />
  </head>

  <body class="antialiased selection:bg-neon-pink selection:text-white">
    <CoreHeader transition:animate={fade({ duration: '.5s' })} />

    <main class="bg-dark max-w-5xl mx-auto px-5 md:px-0 relative">
      <div transition:animate={slide({ duration: '1s' })}>
        <slot />
      </div>
    </main>

    <slot name="after-main-content" />

    <CoreFooter transition:animate={fade({ duration: '.5s' })} />

    <LoadingOverlay />

    <script>
      import AOS from 'aos';
      import 'aos/dist/aos.css';

      const routeLoading = document.getElementById('route-loading');
      const showRouteLoading = () => routeLoading?.classList.add('active');
      const hideRouteLoading = () => routeLoading?.classList.remove('active');

      document.addEventListener('astro:before-preparation', () => {
        showRouteLoading();
      });

      document.addEventListener('astro:page-load', () => {
        hideRouteLoading();
      });

      document.addEventListener('astro:page-load', () => {
        if (typeof AOS !== 'undefined') {
          AOS.init({
            easing: 'ease',
            duration: 1800,
          });
        }

        const menuToggler = document.getElementById('menu-toggler');
        const mobileMenu = document.getElementById('mobile-menu');

        if (menuToggler && mobileMenu) {
          menuToggler.addEventListener('click', () => {
            menuToggler.classList.toggle('open');
            mobileMenu.classList.toggle('hidden');
          });

          document.querySelectorAll('#mobile-menu a').forEach((link) => {
            link.addEventListener('click', () => {
              menuToggler.classList.remove('open');
              mobileMenu.classList.add('hidden');
            });
          });
        }
      });
    </script>
  </body>
</html>
