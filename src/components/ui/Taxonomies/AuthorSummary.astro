---
interface Props {
  autor: {
    id: number;
    status: string;
    name: string;
    email: string;
    bio?: string;
    avatar?: string;
    social_links?: {
      facebook?: string;
      instagram?: string;
      linkedin?: string;
      equis?: string;
    };
    slug: string;
  };
}
const { autor } = Astro.props;

const publicAssetsUrl = import.meta.env.PUBLIC_ASSETS;

const getAvatarUrl = (avatar?: string) =>
  avatar
    ? avatar.startsWith('http')
      ? avatar
      : `${publicAssetsUrl}/${avatar}`
    : undefined;

const avatarUrl = getAvatarUrl(autor.avatar);

const socials = [
  { key: 'facebook', label: 'Facebook', href: autor.social_links?.facebook },
  { key: 'instagram', label: 'Instagram', href: autor.social_links?.instagram },
  { key: 'linkedin', label: 'LinkedIn', href: autor.social_links?.linkedin },
  { key: 'equis', label: 'X', href: autor.social_links?.equis },
].filter((social) => social.href);
---

<section class="bg-dark pb-10 pt-8 md:pb-16 md:pt-16">
  <div class="mx-auto max-w-7xl px-5 md:px-0">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-3">
      <div class="group lg:col-span-1">
        <div
          class="relative aspect-square overflow-hidden border-4 border-dark bg-gray-700 neo-shadow-pink transition-all duration-300 hover:rotate-1"
        >
          {
            avatarUrl ? (
              <img
                class="w-full h-full object-cover grayscale transition-all duration-300 group-hover:grayscale-0 group-hover:scale-105"
                src={avatarUrl}
                alt={`Foto de ${autor.name}`}
                loading="lazy"
              />
            ) : (
              <div
                class="w-full h-full flex items-center justify-center bg-dark text-8xl font-black uppercase text-neon-pink"
              >
                {autor.name.charAt(0)}
              </div>
            )
          }
          <span
            class="absolute left-0 top-0 border-b-2 border-r-2 border-dark bg-neon-yellow px-2 py-1 text-xs font-black uppercase tracking-widest text-dark"
          >
            Autor Core
          </span>
        </div>

        {
          socials.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-3">
              {socials.map((social) => (
                <a
                  aria-label={social.label}
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-dark p-2.5 text-white neo-border-cyan neo-shadow-cyan transition-neo hover:translate-x-0.5 hover:-translate-y-0.5"
                >
                  {
                    social.key === 'facebook' ? (
                      <svg
                        class="h-5 w-5"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                      </svg>
                    ) : social.key === 'instagram' ? (
                      <svg
                        class="h-5 w-5"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                      </svg>
                    ) : social.key === 'linkedin' ? (
                      <svg
                        class="h-5 w-5"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                        <rect x="2" y="9" width="4" height="12"></rect>
                        <circle cx="4" cy="4" r="2"></circle>
                      </svg>
                    ) : (
                      <svg
                        class="h-5 w-5"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M4 4l16 16M20 4L4 20"></path>
                      </svg>
                    )
                  }
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div
        class="bg-dark p-8 text-white neo-border-green neo-shadow-green transition-neo md:p-10 lg:col-span-2"
      >
        <span
          class="inline-block border-2 border-dark bg-neon-pink px-3 py-1 text-xs font-black uppercase tracking-widest text-dark"
        >
          Perfil
        </span>
        <h2 class="mt-4 text-4xl font-black uppercase leading-none tracking-tight md:text-6xl">
          {autor.name}
        </h2>
        <div
          class="mt-4 h-2 bg-gradient-to-r from-neon-pink via-neon-cyan to-neon-green"
        ></div>
        {
          autor.bio && (
            <p class="mt-6 font-mono text-sm leading-relaxed text-gray-100 md:text-base">
              {autor.bio}
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>