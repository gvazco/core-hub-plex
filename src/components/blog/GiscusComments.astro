---
// src/components/GiscusComments.astro
// Eliminamos la interfaz Props y pageId ya que Astro/Giscus manejarán el pathname automáticamente
const enviroment = import.meta.env;

const REPO = enviroment.REPO;
const REPO_ID = enviroment.REPO_ID;
const CATEGORY = enviroment.GISCUS_CATEGORY;
const CATEGORY_ID = enviroment.GISCUS_CATEGORY_ID;
---

<div class="giscus-container">
  <script
    src="https://giscus.app/client.js"
    data-repo={REPO}
    data-repo-id={REPO_ID}
    data-category={CATEGORY}
    data-category-id={CATEGORY_ID}
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="es"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</div>

<style>
  .giscus-container {
    margin-top: 2rem;
    margin-bottom: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
    width: 100%;
  }
</style>
